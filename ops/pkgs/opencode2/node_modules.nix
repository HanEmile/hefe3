# Vendored from upstream nix/node_modules.nix (opencode v2.0.29), adjusted
# to take the source tree as an argument (srcFull) so that ./default.nix can
# inject the release tarball with the ghostty-web github: dep rewritten to a
# codeload tarball URL -- api.github.com is unreachable here, and bun
# resolves github: deps through the GitHub API. The install logic is
# identical to upstream; only the src plumbing changed. When bumping
# opencode, diff this against the new tag's nix/node_modules.nix.
{
  lib,
  stdenvNoCC,
  bun,
  rev ? "dirty",
  hash,
  srcFull, # full opencode source tree (relocated deps rewritten)
  scriptsDir, # nix/scripts inside the release tarball
  # bun's dependency selection target; defaults to the host platform. Can be
  # overridden to harvest the FOD hash for another platform from a darwin
  # host (bun only downloads, no foreign binaries are executed).
  bunCpu ? (if stdenvNoCC.hostPlatform.isAarch64 then "arm64" else "x64"),
  bunOs ? (if stdenvNoCC.hostPlatform.isLinux then "linux" else "darwin"),
}:
let
  packageJson = lib.pipe (srcFull + "/packages/cli/package.json") [
    builtins.readFile
    builtins.fromJSON
  ];
in
stdenvNoCC.mkDerivation {
  pname = "opencode-node_modules";
  version = "${packageJson.version}+${lib.replaceString "-" "." rev}";

  # Upstream uses lib.fileset here; srcFull is a derivation output (patched
  # tarball), which lib.fileset rejects, so the same file selection is
  # expressed with lib.sources.
  src = lib.sources.cleanSourceWith {
    src = srcFull;
    filter =
      let
        base = toString srcFull;
        keep = [
          "packages"
          "services"
          "bun.lock"
          "package.json"
          "patches"
          "install" # required by desktop build (cli.rs include_str!)
          # required by @opencode/script (whole dir: the filter prunes
          # directories before descending, unlike upstream's lib.fileset)
          ".github"
          # v2.0.29: packages/cli/script/build.ts imports
          # ../../../script/native-arch; upstream's fileset misses it.
          "script"
        ];
      in
      path: type:
      let
        rel = lib.removePrefix base (toString path); # "" for the root, "/<p>" below it
      in
      rel == "" || lib.any (e: rel == "/${e}" || lib.hasPrefix "/${e}/" rel) keep;
  };

  impureEnvVars = lib.fetchers.proxyImpureEnvVars ++ [
    "GIT_PROXY_COMMAND"
    "SOCKS_SERVER"
  ];

  nativeBuildInputs = [ bun ];

  dontConfigure = true;

  buildPhase = ''
    runHook preBuild
    export BUN_INSTALL_CACHE_DIR=$(mktemp -d)
    bun install \
      --cpu="${bunCpu}" \
      --os="${bunOs}" \
      --filter '!./' \
      --filter './packages/cli' \
      --filter './packages/desktop' \
      --filter './packages/app' \
      --frozen-lockfile \
      --ignore-scripts \
      --no-progress
    bun --bun ${scriptsDir}/canonicalize-node-modules.ts
    bun --bun ${scriptsDir}/normalize-bun-binaries.ts
    runHook postBuild
  '';

  installPhase = ''
    runHook preInstall
    mkdir -p $out
    find . -type d -name node_modules -exec cp -R --parents {} $out \;
    runHook postInstall
  '';

  dontFixup = true;

  outputHashAlgo = "sha256";
  outputHashMode = "recursive";
  outputHash = hash;

  meta.platforms = [
    "aarch64-linux"
    "x86_64-linux"
    "aarch64-darwin"
  ];
}
