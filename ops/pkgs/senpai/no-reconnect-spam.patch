diff --git a/window.go b/window.go
index 160a32c..4c9c316 100644
--- a/window.go
+++ b/window.go
@@ -27,6 +27,25 @@ type statusLine struct {
 	line  ui.Line
 }
 
+type networkStatus struct {
+	netID   string
+	offline bool
+}
+
+// setNetworkOffline marks netID as (dis)connected in the UI, without adding
+// a line to any buffer's backlog: repeated connection attempts otherwise
+// interleave noisy status lines into the scrollback of every buffer on that
+// network.
+func (app *App) setNetworkOffline(netID string, offline bool) {
+	app.postEvent(event{
+		src: "*",
+		content: networkStatus{
+			netID:   netID,
+			offline: offline,
+		},
+	})
+}
+
