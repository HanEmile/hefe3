(in-package :order)

(defun walk-directory-files (directory predicate)
  "Recursively collect files under DIRECTORY matching PREDICATE, skipping hidden entries."
  (let ((results nil))
    (labels ((walk (dir)
               (dolist (entry (directory (merge-pathnames "*.*" dir)))
                 (let ((name (file-namestring entry)))
                   (when (and (> (length name) 0) (not (char= (char name 0) #\.))
                              (pathname-name entry) (funcall predicate entry))
                     (push entry results))))
               (dolist (subdir (directory (merge-pathnames "*/" dir)))
                 (let ((dn (first (last (pathname-directory subdir)))))
                   (unless (and (stringp dn) (> (length dn) 0) (char= (char dn 0) #\.))
                     (walk subdir))))))
      (walk (truename directory)))
    (nreverse results)))

(defun find-md-files (dir)
  (walk-directory-files dir (lambda (e) (string-equal (pathname-type e) "md"))))

(defun copy-static-files (input-dir output-dir)
  (dolist (entry (walk-directory-files input-dir (lambda (e) (not (string-equal (pathname-type e) "md")))))
    (let ((dest (merge-pathnames (relative-path entry input-dir) output-dir)))
      (ensure-directories-exist dest)
      (with-open-file (in entry :direction :input :element-type '(unsigned-byte 8))
        (with-open-file (out dest :direction :output :if-exists :supersede :element-type '(unsigned-byte 8))
          (let ((buf (make-array 8192 :element-type '(unsigned-byte 8))))
            (loop for n = (read-sequence buf in) while (> n 0) do (write-sequence buf out :end n))))))))

(defun object-web-url (object input-dir)
  (let* ((rel (relative-path (object-path object) input-dir))
         (name (pathname-name (pathname rel))) (dir (directory-namestring (pathname rel))))
    (if (string-equal name "README") (concatenate 'string "/" dir)
        (concatenate 'string "/" dir name "/"))))

(defun object-output-path (object input-dir output-dir)
  (let* ((rel (relative-path (object-path object) input-dir))
         (base (let ((dir (directory-namestring (pathname rel))) (name (pathname-name (pathname rel))))
                 (if (string-equal name "README") (concatenate 'string dir "index.html")
                     (concatenate 'string dir name "/index.html")))))
    (merge-pathnames base output-dir)))

(defun filter-by-visibility (objects max-visibility)
  (remove-if-not (lambda (o) (visibility-visible-p (object-visibility o) max-visibility)) objects))

;;; ---- Auto-generated property pages ----

(defvar *skip-auto-page-properties* '(:id :title :connects-to :mac))
(defvar *comma-separated-properties* '(:tags :services :contains))
(defvar *auto-page-type-map* '(:contains "item" :services "service"))
(defparameter *max-auto-page-value-length* 30)

(defun collect-all-property-keys (objects)
  (let ((keys nil))
    (dolist (o objects)
      (loop for (key val) on (object-properties o) by #'cddr
            unless (member key *skip-auto-page-properties*) do (pushnew key keys)))
    keys))

(defun looks-like-identifier-p (value)
  (let ((v (string-trim '(#\Space) value)))
    (or (every (lambda (c) (or (digit-char-p c) (char= c #\.))) v)
        (and (> (length v) 0) (digit-char-p (char v 0))
             (let ((sp (position #\Space v)))
               (and sp (every (lambda (c) (or (digit-char-p c) (char= c #\.))) (subseq v 0 sp)))))
        (and (>= (length v) 2) (digit-char-p (char v 0))
             (let ((fa (position-if #'alpha-char-p v)))
               (and fa (> fa 0) (every (lambda (c) (or (digit-char-p c) (char= c #\.))) (subseq v 0 fa)))))
        (and (>= (length v) 7)
             (every (lambda (c) (or (digit-char-p c) (char= c #\.) (char= c #\/))) v)
             (>= (count #\. v) 3))
        (and (>= (length v) 12)
             (every (lambda (c) (or (digit-char-p c) (char= c #\:) (char= c #\-)
                                    (find c "abcdefABCDEF"))) v)
             (>= (count #\: v) 4))
        (and (> (length v) 0) (char= (char v 0) #\/))
        (and (>= (length v) 32)
             (every (lambda (c) (or (digit-char-p c) (char= c #\-) (find c "abcdef"))) v)))))

(defun auto-page-worthy-p (value)
  (and (<= (length value) *max-auto-page-value-length*) (> (length value) 0)
       (not (looks-like-identifier-p value))))

(defun collect-property-values (objects property)
  (let ((values nil))
    (dolist (o objects)
      (let ((val (object-property o property)))
        (when (and val (stringp val) (> (length val) 0))
          (if (member property *comma-separated-properties*)
              (dolist (item (split-string val #\,))
                (let ((trimmed (string-trim '(#\Space #\Tab) item)))
                  (when (and (> (length trimmed) 0) (auto-page-worthy-p trimmed))
                    (pushnew trimmed values :test #'string-equal))))
              (when (auto-page-worthy-p val) (pushnew val values :test #'string-equal))))))
    (sort values #'string<)))

(defun make-synthetic-object (id title type visibility)
  (make-obj :properties (list :id id :title title :type type :visibility visibility)
            :content (list (list 'h1 title) '(blank)) :path nil))

(defun generate-auto-pages (objects)
  "Generate synthetic pages for property values, property groups, dates, and types."
  (let ((new nil) (existing (make-hash-table :test 'equal))
        (properties (collect-all-property-keys objects)))
    (dolist (o objects) (setf (gethash (object-id o) existing) t))
    ;; Phase 1: value pages
    (dolist (property properties)
      (let* ((pname (string-downcase (string property)))
             (atype (or (getf *auto-page-type-map* property) pname)))
        (dolist (val (collect-property-values objects property))
          (let ((id (sanitize val)))
            (unless (gethash id existing)
              (let ((syn (make-synthetic-object id val atype "public")))
                (push syn new) (setf (gethash id existing) t)
                (dolist (o objects)
                  (let ((oval (object-property o property)))
                    (when (and oval (stringp oval))
                      (if (member property *comma-separated-properties*)
                          (dolist (item (split-string oval #\,))
                            (when (string-equal (string-trim '(#\Space #\Tab) item) val)
                              (add-backlink syn (object-id o))))
                          (when (string-equal oval val)
                            (add-backlink syn (object-id o)))))))))))))
    ;; Phase 2: property-name grouping pages
    (dolist (property properties)
      (when (member property '(:role :location :tags :services :shelf :status :use :contains))
        (let* ((pname (string-downcase (string property))) (id (sanitize pname)))
          (when (and (some (lambda (o) (string-equal (object-type o) pname)) new)
                     (not (gethash id existing)))
            (let ((gp (make-synthetic-object id pname "property" "public")))
              (push gp new) (setf (gethash id existing) t)
              (dolist (o new) (when (string-equal (object-type o) pname)
                                (add-backlink gp (object-id o)))))))))
    ;; Phase 3: date drilldown pages
    (let ((all (append objects new)) (buckets (make-hash-table :test 'equal)))
      (flet ((bpush (key oid) (pushnew oid (gethash key buckets) :test #'string=)))
        (dolist (o all)
          (loop for (k v) on (object-properties o) by #'cddr
                when (and (stringp v) (date-string-p v))
                do (let ((oid (object-id o)))
                     (bpush v oid) (bpush (subseq v 0 7) oid) (bpush (subseq v 0 4) oid)))))
      (loop for key being the hash-keys of buckets using (hash-value oids)
            for id = (sanitize key)
            unless (gethash id existing)
            do (let ((pg (make-synthetic-object id key
                           (cond ((= (length key) 10) "date") ((= (length key) 7) "month") (t "year"))
                           "public")))
                 (push pg new) (setf (gethash id existing) t)
                 (dolist (oid oids) (add-backlink pg oid)))))
    ;; Phase 4: type-index pages
    (let ((all (append objects new)) (seen (make-hash-table :test 'equal)))
      (dolist (o all) (let ((tp (object-type o))) (when (and tp (> (length tp) 0)) (setf (gethash tp seen) t))))
      (loop for tp being the hash-keys of seen for id = (sanitize tp)
            unless (gethash id existing)
            do (let ((ip (make-synthetic-object id tp "type" "public")))
                 (push ip new) (setf (gethash id existing) t)
                 (dolist (o all) (when (string-equal (object-type o) tp) (add-backlink ip (object-id o)))))))
    (nreverse new)))

(defun synthetic-object-output-path (object output-dir)
  (merge-pathnames (concatenate 'string (object-id object) "/index.html") output-dir))

(defun json-escape (str)
  (if (null str) ""
      (with-output-to-string (out)
        (loop for c across str
              do (case c (#\\ (write-string "\\\\" out)) (#\" (write-string "\\\"" out))
                         (#\Newline (write-string "\\n" out)) (#\Tab (write-string "\\t" out))
                         (#\Return (write-string "\\r" out))
                         (otherwise (unless (< (char-code c) 32) (write-char c out))))))))

(defun object-text-snippet (object &optional (max-len 200))
  (with-output-to-string (s)
    (dolist (element (object-content object))
      (when (> (file-position s) max-len) (return))
      (when (and (listp element) (member (first element) '(text h1 h2 h3 h4 h5 li ol-item)))
        (let ((content (second element)))
          (when (stringp content) (write-string content s) (write-char #\Space s)))))))

(defun generate-search-index (objects output-dir)
  (with-open-file (s (merge-pathnames "search.json" output-dir) :direction :output :if-exists :supersede)
    (write-char #\[ s)
    (loop for obj in objects for i from 0
          do (when (> i 0) (write-char #\, s))
             (format s "{\"id\":\"~A\",\"t\":\"~A\",\"u\":\"~A\",\"y\":\"~A\",\"s\":\"~A\",\"p\":\"~A\"}"
                     (json-escape (object-id obj)) (json-escape (object-title obj))
                     (json-escape (or (object-url obj) "")) (json-escape (object-type obj))
                     (json-escape (object-text-snippet obj 150))
                     (json-escape (or (object-property obj :tags) ""))))
    (write-char #\] s))
  (format t "Search index: ~A objects~%" (length objects)))

(defun strip-invisible-links (line build-vis)
  (let ((result line))
    (maphash (lambda (id vis)
               (when (< (visibility-level build-vis) (visibility-level vis))
                 (loop (let ((ls (search (format nil "/~A/" id) result)))
                         (unless ls (return))
                         (let ((po (search "](" result :end2 ls :from-end t)))
                           (if po
                               (let ((bo (position #\[ result :end po :from-end t))
                                     (pc (position #\) result :start ls)))
                                 (if (and bo pc)
                                     (setf result (concatenate 'string (subseq result 0 bo)
                                                               (subseq result (1+ bo) po)
                                                               (subseq result (1+ pc))))
                                     (return)))
                               (return)))))))
             *visibility-map*)
    result))

(defun strip-invisible-sections (text build-vis)
  (let ((lines (split-string text #\Newline)) (result nil) (skip-depth 0)
        (build-level (visibility-level build-vis)))
    (dolist (line lines)
      (let ((trimmed (string-trim '(#\Space #\Tab) line)))
        (cond
          ((and (starts-with-p trimmed "(vis-start")
                (let* ((q1 (position #\" trimmed))
                       (q2 (when q1 (position #\" trimmed :start (1+ q1)))))
                  (when (and q1 q2)
                    (let ((needed (visibility-level (subseq trimmed (1+ q1) q2))))
                      (if (>= build-level needed) nil (progn (incf skip-depth) t)))))))
          ((starts-with-p trimmed "(vis-end)")
           (when (> skip-depth 0) (decf skip-depth)))
          ((= skip-depth 0) (push (strip-invisible-links line build-vis) result)))))
    (join-strings (nreverse result) (string #\Newline))))

;;; ---- Deadlink detection ----

(defun strip-tags (input open close)
  "Strip content between OPEN and CLOSE tags from INPUT."
  (with-output-to-string (result)
    (let ((i 0) (len (length input)))
      (loop while (< i len)
            do (let ((start (search open input :start2 i :test #'char-equal)))
                 (if start
                     (progn (write-string (subseq input i start) result)
                            (let ((end (search close input :start2 start :test #'char-equal)))
                              (setf i (if end (+ end (length close)) len))))
                     (progn (write-string (subseq input i) result) (setf i len))))))))

(defun extract-hrefs (html)
  (let ((src (strip-tags (strip-tags html "<script" "</script>") "<style" "</style>"))
        (results nil) (i 0))
    (loop with len = (length src) while (< i len)
          do (let ((pos (search "href=\"" src :start2 i)))
               (if pos
                   (let* ((start (+ pos 6)) (end (position #\" src :start start)))
                     (if end (progn (push (subseq src start end) results) (setf i end))
                         (setf i len)))
                   (setf i len))))
    (nreverse results)))

(defun external-or-pseudo-link-p (href)
  (or (search "://" href) (starts-with-p href "//") (starts-with-p href "mailto:")
      (starts-with-p href "javascript:") (starts-with-p href "tel:")
      (starts-with-p href "#") (zerop (length href))))

(defun resolve-link-target (href source-file output-dir)
  (when (external-or-pseudo-link-p href) (return-from resolve-link-target nil))
  (let* ((clean (let* ((q (position #\? href)) (wq (if q (subseq href 0 q) href))
                        (h (position #\# wq))) (if h (subseq wq 0 h) wq)))
         (abs-p (and (> (length clean) 0) (char= (char clean 0) #\/)))
         (base (if abs-p (namestring output-dir) (directory-namestring source-file)))
         (rel (if abs-p (subseq clean 1) clean))
         (joined (concatenate 'string base rel)))
    (let ((bn (let ((ls (position #\/ joined :from-end t)))
                (if ls (subseq joined (1+ ls)) joined))))
      (cond ((zerop (length rel)) (pathname (concatenate 'string base "index.html")))
            ((char= (char joined (1- (length joined))) #\/)
             (pathname (concatenate 'string joined "index.html")))
            ((not (find #\. bn)) (pathname (concatenate 'string joined "/index.html")))
            (t (pathname joined))))))

(defun list-output-html-files (output-dir)
  (walk-directory-files output-dir (lambda (e) (equal (pathname-type e) "html"))))

(defun output-path-to-url (path output-dir)
  (let* ((base (or (ignore-errors (truename output-dir)) output-dir))
         (rel (relative-path path base))
         (stripped (if (and (>= (length rel) 10)
                            (string= rel "index.html" :start1 (- (length rel) 10)))
                       (subseq rel 0 (- (length rel) 10)) rel)))
    (concatenate 'string "/" stripped)))

(defun find-deadlinks (output-dir)
  (let* ((resolved (or (ignore-errors (truename output-dir)) output-dir)) (report nil))
    (dolist (file (list-output-html-files resolved))
      (let ((dead nil))
        (dolist (href (extract-hrefs (read-file (namestring file))))
          (let ((target (resolve-link-target href file resolved)))
            (when (and target (not (probe-file target)) (not (member href dead :test #'string=)))
              (push href dead))))
        (when dead (push (cons (output-path-to-url file resolved) (nreverse dead)) report))))
    (sort (nreverse report) #'string< :key #'car)))

(defun build-deadlinks-object (report)
  (let* ((total (reduce #'+ report :key (lambda (p) (length (cdr p))) :initial-value 0))
         (content (list '(h1 "Deadlinks") '(blank)
                        (list 'text (if (null report) "No deadlinks. All internal links resolve to existing pages."
                                        (format nil "~A broken link~:P across ~A page~:P." total (length report))))
                        '(blank))))
    (dolist (entry report)
      (let ((src (car entry)))
        (setf content (nconc content
                             (list (list 'h2 src) (list 'text (list 'link (format nil "visit ~A" src) src)) '(blank))
                             (mapcar (lambda (href) (list 'li (list 'code href))) (cdr entry))
                             (list '(blank))))))
    (let ((obj (make-synthetic-object "deadlinks" "Deadlinks" "page" "public")))
      (setf (obj-content obj) content) obj)))

(defun render-deadlinks-page (report output-dir input-dir site-name style all-objects)
  (let* ((obj (build-deadlinks-object report))
         (total (reduce #'+ report :key (lambda (p) (length (cdr p))) :initial-value 0)))
    (let ((url (format nil "/~A/" (object-id obj))))
      (setf (obj-url obj) url (gethash (object-id obj) *url-map*) url
            (gethash (object-id obj) *visibility-map*) (object-visibility obj)))
    (let ((*object-db* (cons obj all-objects)))
      (write-file (synthetic-object-output-path obj output-dir)
                  (render-to-html obj :site-name site-name :style style :base-path input-dir)))
    (format t "Deadlinks: ~A broken link~:P across ~A page~:P~%" total (length report))
    obj))

(defun build-site (&key input-dir output-dir site-name (visibility "private") (full nil))
  (let* ((input-dir (truename input-dir))
         (output-dir (ensure-directories-exist
                      (pathname (ensure-trailing-slash (namestring output-dir)))))
         (style (read-file (namestring (merge-pathnames "style.css" input-dir))))
         (old-manifest (if full (make-hash-table :test 'equal) (load-manifest output-dir)))
         (all-objects (mapcar #'make-object (find-md-files input-dir))))
    (format t "Found ~A objects~%" (length all-objects))
    (let ((auto-pages (generate-auto-pages all-objects)))
      (format t "Generated ~A auto-pages~%" (length auto-pages))
      (setf all-objects (append all-objects auto-pages)))
    (clrhash *url-map*) (clrhash *visibility-map*)
    (dolist (o all-objects)
      (let ((url (if (obj-path o) (object-web-url o input-dir) (format nil "/~A/" (object-id o)))))
        (setf (obj-url o) url (gethash (object-id o) *url-map*) url
              (gethash (object-id o) *visibility-map*) (object-visibility o))))
    (build-backlinks all-objects)
    (let ((dirty (compute-dirty-set all-objects old-manifest)))
      (format t "Dirty: ~A of ~A objects~%" (hash-table-count dirty) (length all-objects))
      (let ((objects (filter-by-visibility all-objects visibility)) (n 0))
        (let ((*object-db* objects) (*build-visibility* visibility))
          (dolist (object objects)
            (when (gethash (object-id object) dirty)
              (let ((out-path (if (obj-path object)
                                  (object-output-path object input-dir output-dir)
                                  (synthetic-object-output-path object output-dir))))
                (write-file out-path (render-to-html object :site-name site-name :style style :base-path input-dir))
                (when (obj-path object)
                  (let ((md-dest (merge-pathnames (file-namestring (obj-path object))
                                                  (make-pathname :directory (pathname-directory out-path)))))
                    (ensure-directories-exist md-dest)
                    (write-file md-dest (strip-invisible-sections
                                         (read-file (namestring (obj-path object))) visibility))))
                (incf n)))))
        (format t "Rendered ~A objects~%" n)))
    (let* ((visible (filter-by-visibility all-objects visibility))
           (dl-obj (render-deadlinks-page (find-deadlinks output-dir) output-dir input-dir
                                          site-name style visible)))
      (generate-search-index (cons dl-obj visible) output-dir))
    (save-manifest output-dir (update-manifest all-objects old-manifest))
    (when full (copy-static-files input-dir output-dir))
    (format t "Done.~%")))
