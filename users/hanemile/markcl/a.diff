+  "Parses a string from the stream with basic Markdown syntax and embedded Lisp."
+  (let ((result (list 'list)))
     (loop for char = (read-char stream nil nil)
           while (and char (char/= char #\"))
           do (case char
                (#\# (push (parse-heading stream) result))
                (#\- (push (parse-list stream) result))
                (#\* (push (parse-bold stream) result))
                (#\[ (push (parse-link stream) result))
-               (otherwise (unread-char char stream)
-                          (push (read-line stream) result))))
+               (#\( (unread-char char stream)
+                    (push (read stream t nil t) result))
+               (otherwise
+                (push (parse-text stream char) result))))
     (nreverse result)))
+
+(defun parse-text (stream initial-char)
+  "Parses plain text until a special character or the end of the string."
+  (with-output-to-string (s)
+    (write-char initial-char s)
+    (loop for char = (read-char stream nil nil)
+          while (and char (not (find char "#-*[\"")))
+          do (write-char char s)
+          finally (when char (unread-char char stream)))))
 
