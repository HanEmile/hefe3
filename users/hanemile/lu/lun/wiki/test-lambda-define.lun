;; test-define-in-lambda.lun

(print "Test 1: define in lambda")
(define test1 (lambda ()
  (define x 42)
  x))

(print (test1))

(print "Test 2: nested defines")
(define test2 (lambda ()
  (define a 1)
  (define b 2)
  (+ a b)))

(print (test2))

(print "Test 3: define with function call")
(define test3 (lambda ()
  (define result (+ 10 20))
  result))

(print (test3))

(print "All tests passed!")
